# CineMithresh Cinema Booking System - Environment Configuration Example
# Copy this file to .env and configure for your local environment

# Flask Application Settings
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=True
PORT=8000
SECRET_KEY=cinemithresh_dev_secret_key_change_in_production_99440

# MySQL Database Configuration
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cinemithresh_db

# Fallback SQLite path if MySQL service is not currently running
SQLITE_DB_PATH=cinemithresh.sqlite3

# Payment Gateway Configuration (Test Mode Sandbox)
PAYMENT_MODE=test
PAYMENT_MERCHANT_NAME=CineMithresh Box Office
PAYMENT_CURRENCY=INR

# ==========================================
# Media / CDN Configuration (AWS S3 + CloudFront)
# ==========================================
# Public base URL for all posters, backdrops and brand assets. For local
# development point it at the built-in static media folder (no CDN required);
# for production use your bucket/CDN origin, e.g.
#   MEDIA_BASE_URL=https://dxxxxxxxx.cloudfront.net
MEDIA_BASE_URL=/static/media

# CDN-only mode. When true, refuse the local fallback and fail (backend) or
# show a placeholder (frontend) if MEDIA_BASE_URL is missing. Keep in sync with
# MEDIA_REQUIRE_CDN in static/app.js.
MEDIA_REQUIRE_CDN=False

# AWS credentials for scripts/upload_media.py (use a scoped IAM user,
# never root keys). Keep this file out of version control.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
S3_BUCKET=
# Optional key prefix inside the bucket, e.g. "media"
S3_PREFIX=
